msgid "Configure the default language, the base slug for the boats section, and the SEO templates (title/description/H1). Supports simple multi-language format such as: \"es:barcos,en:boats,fr:bateaux\"."
msgstr "Configurez la langue par défaut, le slug de base pour la section des bateaux et les modèles SEO (titre/description/H1). Prend en charge un format multilingue simple tel que : \"es:barcos,en:boats,fr:bateaux\"."

msgid "Used for SEO when the language cannot be detected (or there is no mapping)."
msgstr "Utilisé pour le SEO lorsque la langue ne peut pas être détectée (ou lorsqu’il n’y a pas de correspondance)."

msgid "Examples: \"boats\" or \"alquiler-barcos\". Simple multi-language: \"es:barcos,en:boats,fr:bateaux\"."
msgstr "Exemples : \"boats\" ou \"alquiler-barcos\". Multilingue simple : \"es:barcos,en:boats,fr:bateaux\"."

msgid "Meta title template"
msgstr "Modèle de méta-titre"

msgid "Insert variable"
msgstr "Insérer une variable"

