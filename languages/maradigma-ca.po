msgid "Dynamic SEO (per boat)"
msgstr "SEO dinàmic (per barca)"

msgid "Configure the default language, the base slug for the boats section, and the SEO templates (title/description/H1). Supports simple multi-language format such as: \"es:barcos,en:boats,fr:bateaux\"."
msgstr "Configura l'idioma per defecte, el slug base per a la secció de barques i les plantilles SEO (títol/descripció/H1). Admet un format multilingüe simple com: \"es:barcos,en:boats,fr:bateaux\"."

msgid "Used for SEO when the language cannot be detected (or there is no mapping)."
msgstr "S'utilitza per a SEO quan no es pot detectar l'idioma (o no hi ha cap mapeig)."

msgid "Examples: \"boats\" or \"alquiler-barcos\". Simple multi-language: \"es:barcos,en:boats,fr:bateaux\"."
msgstr "Exemples: \"boats\" o \"alquiler-barcos\". Multilingüe simple: \"es:barcos,en:boats,fr:bateaux\"."

msgid "Meta title template"
msgstr "Plantilla del meta títol"

msgid "Insert variable"
msgstr "Inserir variable"

msgid "Recommended: “Boat hire {{service_name}} | {{port}}”."
msgstr "Recomanat: “Lloguer de barca {{service_name}} | {{port}}”."

msgid "Meta description template"
msgstr "Plantilla de la meta descripció"

msgid "Recommended: 120-160 characters (Google truncates if you go over)."
msgstr "Recomanat: 120-160 caràcters (Google retalla si t'hi passes)."

msgid "H1 template (optional)"
msgstr "Plantilla H1 (opcional)"

msgid "If your page template already defines its own H1, leave this empty."
msgstr "Si la teva plantilla de pàgina ja defineix el seu propi H1, deixa-ho buit."

