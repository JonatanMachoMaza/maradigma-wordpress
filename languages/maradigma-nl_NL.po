msgid "Dynamic SEO (per boat)"
msgstr "Dynamische SEO (per boot)"

msgid "Configure the default language, the base slug for the boats section, and the SEO templates (title/description/H1). Supports simple multi-language format such as: \"es:barcos,en:boats,fr:bateaux\"."
msgstr "Configureer de standaardtaal, de basis-slug voor de botensectie en de SEO-sjablonen (titel/beschrijving/H1). Ondersteunt een eenvoudig meertalig formaat zoals: \"es:barcos,en:boats,fr:bateaux\"."

msgid "Used for SEO when the language cannot be detected (or there is no mapping)."
msgstr "Gebruikt voor SEO wanneer de taal niet kan worden gedetecteerd (of er geen koppeling is)."

msgid "Examples: \"boats\" or \"alquiler-barcos\". Simple multi-language: \"es:barcos,en:boats,fr:bateaux\"."
msgstr "Voorbeelden: \"boats\" of \"alquiler-barcos\". Eenvoudig meertalig: \"es:barcos,en:boats,fr:bateaux\"."

msgid "Meta title template"
msgstr "Meta-titelsjabloon"

msgid "Insert variable"
msgstr "Variabele invoegen"

msgid "Recommended: “Boat hire {{service_name}} | {{port}}”."
msgstr "Aanbevolen: “Bootverhuur {{service_name}} | {{port}}”."

msgid "Meta description template"
msgstr "Meta-beschrijvingssjabloon"

msgid "Recommended: 120-160 characters (Google truncates if you go over)."
msgstr "Aanbevolen: 120-160 tekens (Google kort af als u eroverheen gaat)."

msgid "H1 template (optional)"
msgstr "H1-sjabloon (optioneel)"

msgid "If your page template already defines its own H1, leave this empty."
msgstr "Als uw paginasjabloon al een eigen H1 definieert, laat dit dan leeg."

