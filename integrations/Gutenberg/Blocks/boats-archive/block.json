    "ids_gi_labels_json": {
      "type": "string",
      "default": ""
    },
    "gc_type": {
      "type": "string",
      "default": ""
    },
    "date_start": {
      "type": "string",
      "default": ""
    },
    "date_end": {
      "type": "string",
      "default": ""
    },
    "search_own_managment": {
      "type": "string",
      "default": ""
    },
    "only_calendarization": {
      "type": "string",
      "default": ""
    },
    "ignore_date_range": {
      "type": "string",
      "default": ""
