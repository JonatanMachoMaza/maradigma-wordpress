{
  "apiVersion": 3,
  "name": "maradigma/boats-archive",
  "version": "0.1.0",
  "title": "Maradigma Boats Archive",
  "category": "maradigma",
  "icon": "grid-view",
  "description": "Boat archive/listing rendered with the existing Maradigma shortcode.",
  "textdomain": "maradigma",
